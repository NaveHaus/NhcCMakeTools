{
  "version": 10,
  "configurePresets": [
    {
      "name": ".defaults",
      "hidden": true,
      "binaryDir": "${sourceDir}/.build/${presetName}"
    },
    {
      "$comment": [
        "Set VCPKG_ROOT.",
        "Defines VCPKG_ROOT, which defaults to _./vcpkg-root_",
        "Note: The value can be overridden by the environment."
      ],
      "name": ".vcpkg-root",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_ROOT": "./vcpkg-root"
      }
    },
    {
      "name": "vs18-vcpkg-mt-s",
      "inherits": [
        ".defaults",
        ".vcpkg-root"
      ],
      "generator": "Visual Studio 18 2026",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.build/.cache-${presetName}",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage",
        "VCPKG_TARGET_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}"
      },
      "environment": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "clangd-msvc18-ninja-vcpkg-mt-s",
      "inherits": [
        ".defaults",
        ".vcpkg-root"
      ],
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/.build/clangd",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_VS_VERSION_RANGE": "[18.0,19.0)",
        "VS_PLATFORM_TOOLSET_VERSION": "14.50",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.build/.cache-${presetName}",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage",
        "VCPKG_TARGET_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/Windows.MSVC.toolchain.cmake"
      },
      "environment": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "clangd-ninja-vcpkg",
      "inherits": [
        ".defaults",
        ".vcpkg-root"
      ],
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/.build/clangd",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.build/.cache-${presetName}",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage",
        "VCPKG_TARGET_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}",
        "VCPKG_HOST_TRIPLET": "$env{VCPKG_TARGET_TRIPLET}"
      },
      "environment": {
        "CC": "clang",
        "CXX": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs18-vcpkg-mt-s-release",
      "configurePreset": "vs18-vcpkg-mt-s",
      "inheritConfigureEnvironment": true,
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "clangd-msvc18-ninja-vcpkg-mt-s-release",
      "configurePreset": "clangd-msvc18-ninja-vcpkg-mt-s",
      "inheritConfigureEnvironment": true,
      "configuration": "Release",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "vs18-vcpkg-mt-s-release",
      "configurePreset": "vs18-vcpkg-mt-s",
      "inheritConfigureEnvironment": true,
      "configuration": "Release",
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "clangd-msvc18-ninja-vcpkg-mt-s-release",
      "configurePreset": "clangd-msvc18-ninja-vcpkg-mt-s",
      "inheritConfigureEnvironment": true,
      "configuration": "Release",
      "execution": {
        "jobs": 0
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "vs18-vcpkg-mt-s-release-test",
      "steps": [
        {
          "type": "configure",
          "name": "vs18-vcpkg-mt-s"
        },
        {
          "type": "build",
          "name": "vs18-vcpkg-mt-s-release"
        },
        {
          "type": "test",
          "name": "vs18-vcpkg-mt-s-release"
        }
      ]
    },
    {
      "name": "clangd-msvc18-ninja-vcpkg-mt-s-release-test",
      "steps": [
        {
          "type": "configure",
          "name": "clangd-msvc18-ninja-vcpkg-mt-s"
        },
        {
          "type": "build",
          "name": "clangd-msvc18-ninja-vcpkg-mt-s-release"
        },
        {
          "type": "test",
          "name": "clangd-msvc18-ninja-vcpkg-mt-s-release"
        }
      ]
    }
  ]
}